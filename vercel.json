{
  "functions": {
    "api/**/*.js": {
      "includeFiles": "nasa_projects_2025.db"
    }
  },
  "rewrites": [
    { "source": "/api/categorias/:cat", "destination": "/api/categorias/[cat].js" },
    { "source": "/api/search", "destination": "/api/search.js" },
    { "source": "/api/facets", "destination": "/api/facets.js" },
    { "source": "/api/stats", "destination": "/api/stats.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "outputDirectory": "dist"
}
